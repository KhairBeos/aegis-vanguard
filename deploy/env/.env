# Local-only runtime configuration.
# Copy deploy/env/.env.example and override values before using shared environments.

# ClickHouse
CLICKHOUSE_DB=aegis
CLICKHOUSE_USER=aegis_user
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_VOLUME_NAME=deploy_clickhouse_data

# Kafka topics
KAFKA_TOPIC_EVENTS=siem.events
KAFKA_TOPIC_ALERTS=siem.alerts
KAFKA_TOPIC_EVENTS_DLQ=siem.events.dlq

# Dashboard
DASHBOARD_PORT=3000

SLACK_WEBHOOK=change_me_slack_webhook