# Safe local example config.
# Copy to deploy/env/.env and keep deploy/env/.env local only.

# ClickHouse
CLICKHOUSE_DB=aegis
CLICKHOUSE_USER=aegis_user
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_VOLUME_NAME=deploy_clickhouse_data

# Approved Phase 1 Kafka topics
KAFKA_TOPIC_RAW=raw.telemetry
KAFKA_TOPIC_NORMALIZED=normalized.events
KAFKA_TOPIC_ALERTS=security.alerts

# Local UI/API ports
DASHBOARD_PORT=3000
BACKEND_PORT=8080
