{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-vanguard.local/schemas/canonical_event.schema.json",
  "title": "AEGIS-VANGUARD Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "timestamp",
    "host",
    "source",
    "event_type",
    "severity",
    "tenant_id",
    "trace_id",
    "event"
  ],
  "properties": {
    "schema": {
      "const": "lab-event"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "process_start",
        "network_connect",
        "auth_failure"
      ]
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "process"
          ],
          "properties": {
            "process": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pid",
                "ppid",
                "user_name",
                "image",
                "command_line"
              ],
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 0
                },
                "ppid": {
                  "type": "integer",
                  "minimum": 0
                },
                "user_name": {
                  "type": "string"
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "command_line": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network"
          ],
          "properties": {
            "network": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pid",
                "process_image",
                "src_ip",
                "src_port",
                "dst_ip",
                "dst_port",
                "protocol",
                "direction"
              ],
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 0
                },
                "process_image": {
                  "type": "string",
                  "minLength": 1
                },
                "src_ip": {
                  "type": "string",
                  "minLength": 1
                },
                "src_port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "dst_ip": {
                  "type": "string",
                  "minLength": 1
                },
                "dst_port": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "protocol": {
                  "enum": [
                    "tcp",
                    "udp"
                  ]
                },
                "direction": {
                  "enum": [
                    "inbound",
                    "outbound"
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "auth"
          ],
          "properties": {
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "user_name",
                "src_ip",
                "auth_method",
                "failure_reason"
              ],
              "properties": {
                "user_name": {
                  "type": "string",
                  "minLength": 1
                },
                "src_ip": {
                  "type": "string",
                  "minLength": 1
                },
                "auth_method": {
                  "type": "string",
                  "minLength": 1
                },
                "failure_reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
