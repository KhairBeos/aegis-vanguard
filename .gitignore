# Build outputs
build/
out/
cmake-build-*/
*.o
*.obj
*.so
*.dll
*.exe

# Native tooling
compile_commands.json

# Node
node_modules/
.next/
dashboard/.next/

# Python
__pycache__/
*.pyc
.venv/
.tmp/

# Local env
deploy/env/.env*
!deploy/env/.env.example
!deploy/env/*.example

# Sensitive key material
*.pem
*.key
*.p12
*.pfx

# Phase 1 generated TLS and local credentials
deploy/tls/.runtime-staging/
deploy/tls/generated/
deploy/secrets/*
!deploy/secrets/README.md
deploy/kibana/config/kibana.keystore

# Standalone Agent policies are generated from Kibana and may contain credentials
deploy/elastic-agent/runtime/

# Runtime data
data/
logs/
deploy/backups/
runtime/*

# IDE
.vscode/
.idea/
.DS_Store
