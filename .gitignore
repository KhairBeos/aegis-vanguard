# Build outputs
build/
out/
cmake-build-*/
*.o
*.obj
*.so
*.dll
*.exe

# Native tooling
compile_commands.json

# Node
node_modules/
.next/
dashboard/.next/

# Python
__pycache__/
*.pyc
.venv/
.tmp/

# Local env
deploy/env/.env*
!deploy/env/.env.example
!deploy/env/*.example
/infra/elastic/.env

# Sensitive key material
*.pem
*.key
*.p12
*.pfx

# Phase 1 generated TLS and local credentials
deploy/tls/.runtime-staging/
deploy/tls/generated/
deploy/secrets/*
!deploy/secrets/README.md
deploy/kibana/config/kibana.keystore

# Standalone Agent policies are generated from Kibana and may contain credentials
deploy/elastic-agent/runtime/

# Local-only test/verification files (never committed)
*.test.*
*.spec.*
__tests__/

# Converted detection rules may embed environment-specific values
rules/generated/

# Runtime data
data/
logs/
deploy/backups/
runtime/*

# IDE
.vscode/
.idea/
.DS_Store

# Claude Code local config. Uses .claude/* rather than .claude/ so the negation below
# still works; git will not descend into a directory ignored with a trailing slash.
# settings.json stays tracked because CLAUDE.md cites it as the source of truth for the
# approval rules. The bundled skills are unrelated to this project and stay out.
.claude/*
!.claude/settings.json
