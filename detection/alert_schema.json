{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aegis-vanguard.local/schemas/alert_schema.json",
  "title": "AEGIS-VANGUARD Alert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "alert_id",
    "timestamp",
    "rule_id",
    "rule_name",
    "severity",
    "risk_score",
    "tenant_id",
    "trace_id",
    "event_id",
    "host",
    "event_type",
    "mitre",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "lab-alert"
    },
    "alert_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1
    },
    "rule_name": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "risk_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "process_start",
        "network_connect",
        "auth_failure"
      ]
    },
    "mitre": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tactics",
        "techniques"
      ],
      "properties": {
        "tactics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "minProperties": 1
    }
  }
}
