{
  "_meta": {
    "managed_by": "AEGIS-VANGUARD",
    "reason": "Sigma matches string values case-insensitively, but Elasticsearch keyword fields do not. Without a lowercase normalizer, a converted rule looking for '-encodedcommand' silently fails to match a real command line containing '-EncodedCommand'. The rule still reports 'succeeded' on every run, so the failure is invisible.",
    "note": "logs@custom is the extension point the built-in 'logs' index template already composes, so no competing index template is needed. The normalizer affects the indexed terms only; _source keeps the original casing, which preserves evidence value."
  },
  "template": {
    "settings": {
      "analysis": {
        "normalizer": {
          "aegis_lowercase": {
            "type": "custom",
            "filter": ["lowercase"]
          }
        }
      },
      "index": {
        "final_pipeline": "aegis-powershell-decode"
      }
    },
    "mappings": {
      "properties": {
        "aegis": {
          "properties": {
            "powershell": {
              "properties": {
                "decoded_command": { "type": "keyword", "normalizer": "aegis_lowercase", "ignore_above": 8192 },
                "decode_status": { "type": "keyword" },
                "decode_error": { "type": "keyword", "ignore_above": 1024 },
                "encoded_token_length": { "type": "integer" }
              }
            }
          }
        },
        "winlog": {
          "properties": {
            "event_data": {
              "properties": {
                "CommandLine": { "type": "keyword", "normalizer": "aegis_lowercase" },
                "Image": { "type": "keyword", "normalizer": "aegis_lowercase" },
                "ParentImage": { "type": "keyword", "normalizer": "aegis_lowercase" },
                "TargetFilename": { "type": "keyword", "normalizer": "aegis_lowercase" },
                "TargetObject": { "type": "keyword", "normalizer": "aegis_lowercase" },
                "QueryName": { "type": "keyword", "normalizer": "aegis_lowercase" },
                "User": { "type": "keyword", "normalizer": "aegis_lowercase" }
              }
            }
          }
        }
      }
    }
  }
}
